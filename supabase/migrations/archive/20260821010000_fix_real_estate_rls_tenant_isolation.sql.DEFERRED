-- =========================================================================
-- Migration: 20260821010000_fix_real_estate_rls_tenant_isolation
-- Purpose: Fix CRITICAL P0 RLS violations in real-estate tables
-- Issue: Real-estate tables using USING (true) bypass tenant isolation
-- Impact: Cross-tenant data leakage - pricing, inventory, promotions
-- =========================================================================
--
-- BACKGROUND:
--   Migration 20260801010000_real_estate_foundation_tables.sql created
--   real-estate tables with permissive USING (true) policies.
--   This violates Gate 0/P0 tenant isolation requirements.
--
-- FIX:
--   Replace USING (true) with proper tenant_id filtering
--
-- TABLES AFFECTED:
--   - re_zones
--   - re_blocks
--   - re_price_lists
--   - re_product_prices
--   - re_promotions
--   - re_price_history
--   - rm_inventory_matrix
-- =========================================================================

-- =========================================================================
-- 1. RE_ZONES (Real Estate Zones)
-- =========================================================================
DROP POLICY IF EXISTS "Allow authenticated users full access to re_zones" ON public.re_zones;
DROP POLICY IF EXISTS "re_zones_tenant_isolation" ON public.re_zones;

CREATE POLICY "re_zones_tenant_isolation" ON public.re_zones
    FOR ALL TO authenticated, service_role
    USING (
        current_user IN ('service_role', 'postgres', 'supabase_admin')
        OR tenant_id = public.get_auth_tenant_id()
    )
    WITH CHECK (
        current_user IN ('service_role', 'postgres', 'supabase_admin')
        OR tenant_id = public.get_auth_tenant_id()
    );

-- =========================================================================
-- 2. RE_BLOCKS (Real Estate Blocks)
-- =========================================================================
DROP POLICY IF EXISTS "Allow authenticated users full access to re_blocks" ON public.re_blocks;
DROP POLICY IF EXISTS "re_blocks_tenant_isolation" ON public.re_blocks;

