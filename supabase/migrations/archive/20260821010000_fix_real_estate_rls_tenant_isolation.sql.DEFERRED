    );

-- =========================================================================
-- 3. RE_PRICE_LISTS (Critical - Pricing Strategy)
-- =========================================================================
DROP POLICY IF EXISTS "Allow authenticated users full access to re_price_lists" ON public.re_price_lists;
DROP POLICY IF EXISTS "re_price_lists_tenant_isolation" ON public.re_price_lists;

CREATE POLICY "re_price_lists_tenant_isolation" ON public.re_price_lists
    FOR ALL TO authenticated, service_role
