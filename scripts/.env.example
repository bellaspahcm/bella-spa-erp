# Decision Engine Automation Scripts Environment Variables
# 
# Copy this file to .env in the project root and fill in the values
# These variables are required for the automation scripts to function

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# For database backups
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_PASSWORD=your-postgres-password

# ============================================
# REDIS CONFIGURATION
# ============================================
# Get from: https://console.upstash.com/redis/YOUR_REDIS
REDIS_URL=redis://default:password@redis.upstash.io:6379

# Cache TTL (seconds)
REDIS_CACHE_TTL=3600

# ============================================
# DECISION ENGINE CONFIGURATION
# ============================================
# Log level: debug, info, warn, error
DECISION_ENGINE_LOG_LEVEL=info

# Feature flags
DECISION_ENGINE_CACHE_ENABLED=true
DECISION_ENGINE_METRICS_ENABLED=true
DECISION_ENGINE_AUDIT_ENABLED=true

# ============================================
# MONITORING & ALERTING
# ============================================
# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty integration key
PAGERDUTY_INTEGRATION_KEY=your-integration-key

# ============================================
# DEPLOYMENT (Optional)
# ============================================
# For GitHub Actions deployment
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-org-id
VERCEL_PROJECT_ID=your-project-id

# Production URL for smoke tests
PRODUCTION_URL=https://bella-spa.vercel.app

# ============================================
# BACKUP (Optional)
# ============================================
# AWS S3 for off-site backups
AWS_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# Local backup directory
BACKUP_DIR=/var/backups/bella-spa
