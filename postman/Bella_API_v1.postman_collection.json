{
  "info": {
    "name": "Bella ERP Partner API v1",
    "description": "Complete API collection for Bella ERP Partner integrations.\n\n## Documentation\n- Getting Started: https://docs.bellaspa.com/api/getting-started\n- API Reference: https://docs.bellaspa.com/api/reference\n- Security: https://docs.bellaspa.com/api/security\n\n## Environments\n- Sandbox: Use `Bella_API_Sandbox` environment with `pk_test_` API key\n- Production: Use `Bella_API_Production` environment with `pk_live_` API key\n\n## Support\n- Email: api-support@bellaspa.com\n- Docs: https://docs.bellaspa.com\n\nVersion: 1.0.0\nLast Updated: 2026-06-18",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "bella-erp"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique idempotency key for mutations",
          "if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(pm.request.method)) {",
          "    const idempotencyKey = pm.variables.replaceIn('{{$guid}}');",
          "    pm.request.headers.add({",
          "        key: 'Idempotency-Key',",
          "        value: idempotencyKey",
          "    });",
          "    pm.environment.set('last_idempotency_key', idempotencyKey);",
          "}",
          "",
          "// Add timestamp",
          "pm.environment.set('request_timestamp', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test assertions",
          "pm.test('Status code is successful', function () {",
          "    pm.response.to.have.status(200);",
          "});",
          "",
          "pm.test('Response has correct content type', function () {",
          "    pm.response.to.have.header('Content-Type', /application\\/json/);",
          "});",
          "",
          "pm.test('Response has standard structure', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "    pm.expect(jsonData).to.have.property('meta');",
          "    pm.expect(jsonData.meta).to.have.property('timestamp');",
          "    pm.expect(jsonData.meta).to.have.property('request_id');",
          "});",
          "",
          "pm.test('Rate limit headers present', function () {",
          "    pm.response.to.have.header('X-RateLimit-Limit');",
          "    pm.response.to.have.header('X-RateLimit-Remaining');",
          "    pm.response.to.have.header('X-RateLimit-Reset');",
          "});",
          "",
          "// Store response time",
          "pm.environment.set('last_response_time', pm.response.responseTime);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Health",
      "item": [
        {
          "name": "Test API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API key is valid', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Partner details returned', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('partner_id');",
                  "    pm.expect(jsonData.data).to.have.property('partner_name');",
                  "    pm.expect(jsonData.data).to.have.property('allowed_scopes');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/verify",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify"]
            },
            "description": "Verify that your API key is valid and retrieve partner information."
          },
          "response": []
        },
        {
          "name": "API Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check API health status."
          },
          "response": []
        }
      ],
      "description": "Authentication verification and health check endpoints."
    },
