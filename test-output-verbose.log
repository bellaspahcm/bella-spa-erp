      const [tenantBrand, setTenantBrand] = useState<ResolvedTenantBrandIdentity | null>(null);
      const [isExportingQuotation, setIsExportingQuotation] = useState(false);
      const [isEditModalOpen, setIsEditModalOpen] = useState(false);
