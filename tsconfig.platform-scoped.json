{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@bella/shared": ["./packages/shared/src"]
    }
  },
  "include": [
    "src/platform/**/*.ts",
    "src/platform/**/*.tsx",
    "src/types/database.types.ts"
  ],
  "exclude": ["node_modules"]
}
