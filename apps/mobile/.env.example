# Bella ERP Mobile - Environment Variables
# Copy this to .env and fill in your values

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry Configuration (Error Monitoring)
# Get DSN from: https://sentry.io/settings/[organization]/projects/bella-mobile/keys/
EXPO_PUBLIC_SENTRY_DSN=https://[hash]@[region].ingest.sentry.io/[project-id]

# Environment (development, staging, production)
EXPO_PUBLIC_ENV=development

# Note: Only EXPO_PUBLIC_* variables are accessible in the app
# DO NOT put sensitive keys here (like service_role_key)
