{
  "expo": {
    "name": "Bella ERP Mobile",
    "slug": "bella-erp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bellaspa.erp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bellaspa.erp"
    },
    "updates": {
      "enabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "bella-erp",
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2372754d-9112-4e46-a8bb-a48b05d055ed"
      }
    },
    "owner": "bellaerpmobile"
  }
}
