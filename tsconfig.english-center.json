{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "src/products/bella-english-center/**/*.ts",
    "src/products/bella-english-center/**/*.tsx",
    "src/app/dashboard/english-center/**/*.ts",
    "src/app/dashboard/english-center/**/*.tsx",
    "src/app/api/english-center/**/*.ts",
    "src/app/api/english-center/**/*.tsx",
    "src/platform/education/contracts/**/*.ts",
    "src/platform/education/domain/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "src/platform/host",
    "src/platform/healthcare",
    "src/platform/logistics",
    "src/services",
    "**/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
