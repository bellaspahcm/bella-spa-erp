{
  "name": "bella-spa-erp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint --config eslint.strict.config.mjs \"src/**/*.{ts,tsx}\"",
    "env:check": "node scripts/check-required-env.mjs",
    "docs:api:check": "node scripts/check-api-docs.mjs",
    "docs:api:versioning": "node scripts/check-api-versioning.mjs",
    "db:access:check": "node scripts/check-supabase-data-access.cjs",
    "db:business:check": "node scripts/check-business-invariants.cjs",
    "db:rpc-grants:check": "node scripts/check-supabase-rpc-grants.cjs",
    "db:rpc-smoke:check": "node scripts/check-supabase-rpc-smoke.cjs",
    "db:migration:check": "node scripts/check-supabase-migrations.cjs",
    "db:migration:zero-downtime": "node scripts/check-zero-downtime-migrations.cjs",
    "demo:beauty": "node scripts/beauty-demo-tenant.cjs",
    "cron:accounting:smoke": "node scripts/check-accounting-worker-cron-smoke.cjs",
    "cron:business-rules:smoke": "node scripts/check-business-rule-production-guard.cjs",
    "security:audit": "node scripts/audit-production.mjs",
    "security:secrets": "node scripts/check-secret-leaks.mjs",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "test:integration:registry": "jest PolicyRegistry.integration.test.ts --runInBand",
    "test:real-db-e2e": "jest --config jest.real-db.config.ts --runInBand",
    "test:critical": "jest src/__tests__/payment-webhook.test.ts src/__tests__/accounting-outbox.test.ts src/__tests__/finance.test.ts src/__tests__/finance-transaction-mutations.test.ts src/__tests__/admin-salary-actions.test.ts src/__tests__/salary-recalculation-lifecycle.test.ts src/__tests__/salary-surface-parity.test.ts src/__tests__/salary-reconciliation.test.ts src/__tests__/salary-reconciliation-summary.test.ts src/__tests__/auth-guards.test.ts src/__tests__/tenant-actions.test.ts src/__tests__/meta-ads-actions.test.ts src/__tests__/meta-ads-ui.test.ts src/__tests__/business-invariants-check.test.ts src/__tests__/ai-autopilot-cron.test.ts src/__tests__/test-upcoming-route.test.ts src/__tests__/portal-payment-utils.test.ts --runInBand",
    "test:intelligence": "jest src/services/intelligence/__tests__/ --coverage --collectCoverageFrom='src/services/intelligence/**/*.ts' --collectCoverageFrom='!src/services/intelligence/**/*.test.ts'",
    "test:coverage": "jest --coverage",
    "test:report": "jest --json --outputFile=test-results.json && node generate-report.js",
    "config:migrate": "tsx scripts/run-config-migrations.ts",
    "config:test": "tsx scripts/test-config-providers.ts",
    "policy:migrate": "tsx scripts/migrate-policies-to-registry.ts",
    "policy:migrate:dry-run": "tsx scripts/migrate-policies-to-registry.ts --dry-run",
    "policy:migrate:force": "tsx scripts/migrate-policies-to-registry.ts --force",
    "policy:verify": "tsx scripts/verify-policy-migration.ts",
    "policy:rollback": "tsx scripts/rollback-policy-migration.ts",
    "e2e": "playwright test",
    "e2e:auth-smoke": "playwright test e2e/tests/12-authenticated-core-routes-smoke.spec.ts",
    "e2e:tenant-isolation": "playwright test e2e/tests/13-tenant-isolation-smoke.spec.ts",
    "e2e:beauty-uat": "playwright test e2e/tests/13-tenant-isolation-smoke.spec.ts e2e/tests/14-beauty-resource-booking-smoke.spec.ts",
    "e2e:visual": "node scripts/run-responsive-visual-smoke.mjs",
    "e2e:visual:assert": "node scripts/assert-playwright-results.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report",
    "load:smoke": "k6 run load-tests/scripts/01-smoke.js",
    "load:dashboard": "k6 run load-tests/scripts/02-dashboard-load.js",
    "load:stress": "k6 run load-tests/scripts/03-booking-stress.js",
    "load:spike": "k6 run load-tests/scripts/04-login-spike.js",
    "load:soak": "k6 run load-tests/scripts/05-checkout-soak.js",
    "load:soak:short": "k6 run -e SOAK_MINUTES=5 load-tests/scripts/05-checkout-soak.js",
    "load:report": "k6 run --out json=load-tests/results/result.json load-tests/scripts/01-smoke.js",
    "ci:env:check": "node scripts/check-ci-quality-env.mjs",
    "mobile:dev": "npm run start --workspace=apps/mobile",
    "mobile:ios": "npm run ios --workspace=apps/mobile",
    "mobile:android": "npm run android --workspace=apps/mobile",
    "mobile:typecheck": "npm run typecheck --workspace=apps/mobile",
    "shared:typecheck": "npm run typecheck --workspace=packages/shared",
    "smoke:test": "npx tsx scripts/smoke-test-position-tier-hire-date.ts",
    "smoke:test:bash": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.2",
    "@upstash/redis": "^1.38.0",
    "ajv": "^8.20.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.20.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "marked": "^18.0.5",
    "md-to-pdf": "^5.2.5",
    "metro": "^0.80.12",
    "metro-resolver": "^0.80.12",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
