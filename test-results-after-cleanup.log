      const handleDiscountChange = (e: React.ChangeEvent<HTMLInputElement>) => {
        const val = e.target.value.trim();
        if (val === '') {
          setDiscountPercent('');
          return;
        }

        const numericValue = Number(val);
        if (Number.isFinite(numericValue)) {
