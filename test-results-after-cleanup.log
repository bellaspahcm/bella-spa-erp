        handleUpdateKTV,
        isBookingModalOpen,
        isCompleted,
        isDepositOnly,
        isEditBookingModalOpen,
        isEditModalOpen,
        isExportingQuotation,
        isPaymentModalOpen,
        isRecordingPayment,
