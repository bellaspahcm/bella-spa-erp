                discountPercent: draft.discount_percent || 0,
                depositAmount: draft.deposit_amount || 0,
                bookingStatus: draft.status,
                revenues: draft.revenue,
              });
              const draftDepositAmount = draftPaymentState.totalPaid;
              setDraftBooking(draft);
