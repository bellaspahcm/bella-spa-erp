                  deposit_amount: 0,
                  total_sessions: 21,
                  start_date: getLocalDateString(),
                  preferred_time: '08:00',
                  assigned_ktv_id: '',
                });
                setDiscountPercent('');
              }
            }
          };
          loadDraft();
        }
      }, [selectedCustomer, step]);


