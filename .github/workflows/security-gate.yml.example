name: Security Gate - Architectural Invariants

on:
  pull_request:
    branches: [main, develop]
  push:
    branches: [main, develop]

jobs:
  security-gate:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Run Invariant Tests
        id: invariants
        run: |
          echo "::group::Running Security Gate Invariants"
          npm test -- production-runtime-integrity --coverage=false
          echo "::endgroup::"
        env:
          CI: true

      - name: Security Gate Status
        if: success()
        run: |
          echo "✅ SECURITY GATE PASS"
          echo "All architectural invariants verified:"
          echo "  - Production Type Safety: PASS"
          echo "  - RLS Tenant Isolation: PASS"
          echo "  - Contract Boundaries: PASS"
          echo "  - Build Integrity: PASS"

      - name: Security Gate Failure
        if: failure()
        run: |
          echo "❌ SECURITY GATE FAILED"
          echo ""
          echo "One or more architectural invariants violated."
          echo "Common violations:"
          echo "  - New production 'any' type introduced"
          echo "  - RLS policy regression"
          echo "  - Direct hc_* table access from UI"
          echo "  - Contract boundary violation"
          echo ""
          echo "Fix violations before merging."
          echo "See: docs/security/SECURITY_RECONCILIATION_2026-08-16.md"
          exit 1

      - name: Comment PR on Failure
        if: failure() && github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: `## ❌ Security Gate Failed

              **Architectural invariant violation detected.**

              One or more of the following checks failed:
              - Production Type Safety (no \`any\` types)
              - RLS Tenant Isolation
              - Healthcare Contract Boundary
              - UI Persistence Boundary
              - Build Integrity

              **Action Required:**
              1. Review test output above
              2. Fix identified violations
              3. Run \`npm test -- production-runtime-integrity\` locally
              4. Push fix to trigger re-check

              **Reference:** \`docs/security/SECURITY_RECONCILIATION_2026-08-16.md\`
              `
            })

  type-check:
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: TypeScript Check
        run: npm run type-check

      - name: TypeScript Failure
        if: failure()
        run: |
          echo "❌ TypeScript errors detected"
          echo "Fix all type errors before merging"
          exit 1
