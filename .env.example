# Bella Spa ERP environment contract
# Copy this file to .env.local and fill values for local builds.
# Never commit real secrets.

# Required for browser, middleware, server actions, and production build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy fallback only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-supabase-anon-key

# Required for server-only privileged workflows:
# accounting worker, payment webhook, onboarding, portal token access,
# AI/automation tools, and rollback-safe cross-table operations.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy fallback only. Do not re-enable leaked legacy JWT keys.
SUPABASE_SERVICE_ROLE_KEY=your-legacy-supabase-service-role-key

# Required when payment webhook endpoint is enabled.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Required for Vercel cron endpoints.
CRON_SECRET=replace-with-a-long-random-secret

# Optional production alert tenant for GitHub scheduled smoke checks.
# If BUSINESS_RULE_ALERT_TENANT_ID is empty, it falls back to ACCOUNTING_ALERT_TENANT_ID.
ACCOUNTING_ALERT_TENANT_ID=
BUSINESS_RULE_ALERT_TENANT_ID=
BUSINESS_RULE_GUARD_FAIL_ON_WARNING=0
DB_BUSINESS_INVARIANT_MAX_ROWS=20000

# Required when Telegram webhook is enabled.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Required when encrypted fields are enabled.
# Use a stable 32-byte secret or the format expected by src/lib/crypto.ts.
DB_ENCRYPTION_KEY=replace-with-a-stable-encryption-secret

# Optional fallback tenant for public/online booking flows.
DEFAULT_TENANT_ID=

# Optional AI provider key for AI COO features.
GEMINI_API_KEY=

# Optional rate limit backend. Supported default is memory; use supabase only
# when Supabase-backed rate-limit state is configured.
RATE_LIMIT_BACKEND=memory

# Optional observability.
NEXT_PUBLIC_SENTRY_DSN=

# Optional Playwright production-safe smoke auth.
# Keep these only in .env.local or CI/Vercel secret storage, never in git.
E2E_BASE_URL=https://bella-spa-erp.vercel.app
E2E_ADMIN_EMAIL=smoke-admin@example.com
E2E_ADMIN_PASSWORD=replace-with-smoke-admin-password
# Optional for protected Vercel Preview deployments.
E2E_VERCEL_AUTOMATION_BYPASS_SECRET=
